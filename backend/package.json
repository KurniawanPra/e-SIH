{
    "name": "sso-target-fastify4",
    "version": "1.0.0",
    "private": true,
    "description": "Template backend aplikasi tujuan SSO Portal dengan Fastify 4",
    "engines": {
        "node": ">=18.17.0"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/server.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsx --test tests/auth.test.ts",
        "seed": "tsx prisma/seed.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@fastify/cors": "9.0.1",
        "@fastify/secure-session": "7.5.1",
        "@libsql/client": "^0.17.4",
        "@prisma/adapter-libsql": "^7.9.1",
        "@prisma/client": "^5.22.0",
        "dotenv": "16.6.1",
        "fastify": "4.29.1",
        "fastify-plugin": "4.5.1",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^20.19.9",
        "prisma": "^5.22.0",
        "tsx": "^4.20.3",
        "typescript": "5.8.3"
    },
    "overrides": {
        "fast-uri": "3.1.4"
    }
}
