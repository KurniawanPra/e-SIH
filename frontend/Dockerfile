FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PORTAL_URL
ARG NEXT_PUBLIC_PORTAL_LOGIN_URL
ARG NEXT_PUBLIC_TARGET_APP_ID
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_APP_DESCRIPTION
ARG NEXT_PUBLIC_APP_LOGO_URL
ARG NEXT_PUBLIC_PORTAL_NAME
ARG NEXT_PUBLIC_PORTAL_ACCOUNT_NAME
ARG NEXT_PUBLIC_BACKEND_DRIVER

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_PORTAL_URL=$NEXT_PUBLIC_PORTAL_URL \
    NEXT_PUBLIC_PORTAL_LOGIN_URL=$NEXT_PUBLIC_PORTAL_LOGIN_URL \
    NEXT_PUBLIC_TARGET_APP_ID=$NEXT_PUBLIC_TARGET_APP_ID \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NEXT_PUBLIC_APP_DESCRIPTION=$NEXT_PUBLIC_APP_DESCRIPTION \
    NEXT_PUBLIC_APP_LOGO_URL=$NEXT_PUBLIC_APP_LOGO_URL \
    NEXT_PUBLIC_PORTAL_NAME=$NEXT_PUBLIC_PORTAL_NAME \
    NEXT_PUBLIC_PORTAL_ACCOUNT_NAME=$NEXT_PUBLIC_PORTAL_ACCOUNT_NAME \
    NEXT_PUBLIC_BACKEND_DRIVER=$NEXT_PUBLIC_BACKEND_DRIVER

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN npm i -g serve@14.2.6
COPY --from=builder /app/out ./out
COPY --from=builder /app/package.json /app/package-lock.json ./
EXPOSE 4100
CMD ["serve", "out", "-l", "4100"]
