# Backend Driver & URL
NEXT_PUBLIC_BACKEND_DRIVER=fastify
# Kosongkan NEXT_PUBLIC_API_URL jika menggunakan same-origin / Next.js rewrites, atau isi http://localhost:3015 untuk direct call
NEXT_PUBLIC_API_URL=
# URL Backend Internal untuk Next.js rewrites (Next.js server-to-backend atau docker service name)
INTERNAL_BACKEND_URL=http://localhost:3015

# Portal INL SSO Configuration
NEXT_PUBLIC_PORTAL_URL=https://portal.inl.co.id
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://portal.inl.co.id/login
NEXT_PUBLIC_TARGET_APP_ID=924b0197-31b4-4620-b15e-c037989b49a3

# Branding & Metadata
NEXT_PUBLIC_APP_NAME=Aplikasi e-SIH
NEXT_PUBLIC_APP_DESCRIPTION=System Highlight Report & Activity Tracking - PT Industri Nabati Lestari
NEXT_PUBLIC_APP_LOGO_URL=/app-logo.svg
NEXT_PUBLIC_PORTAL_NAME=InTes / Portal SSO
NEXT_PUBLIC_PORTAL_ACCOUNT_NAME=Portal INL

# Untuk Backend Laravel (opsional jika beralih):
# NEXT_PUBLIC_BACKEND_DRIVER=laravel
# NEXT_PUBLIC_API_URL=http://localhost:8000
# INTERNAL_BACKEND_URL=http://localhost:8000
