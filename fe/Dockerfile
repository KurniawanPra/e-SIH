FROM node:18-bookworm-slim AS build
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_BACKEND_DRIVER
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PORTAL_URL
ARG NEXT_PUBLIC_PORTAL_LOGIN_URL
ARG NEXT_PUBLIC_TARGET_APP_ID
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_APP_DESCRIPTION
ARG NEXT_PUBLIC_APP_LOGO_URL
ARG NEXT_PUBLIC_PORTAL_NAME
ARG NEXT_PUBLIC_PORTAL_ACCOUNT_NAME

ENV NEXT_PUBLIC_BACKEND_DRIVER=$NEXT_PUBLIC_BACKEND_DRIVER
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_URL=$NEXT_PUBLIC_PORTAL_URL
ENV NEXT_PUBLIC_PORTAL_LOGIN_URL=$NEXT_PUBLIC_PORTAL_LOGIN_URL
ENV NEXT_PUBLIC_TARGET_APP_ID=$NEXT_PUBLIC_TARGET_APP_ID
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_APP_DESCRIPTION=$NEXT_PUBLIC_APP_DESCRIPTION
ENV NEXT_PUBLIC_APP_LOGO_URL=$NEXT_PUBLIC_APP_LOGO_URL
ENV NEXT_PUBLIC_PORTAL_NAME=$NEXT_PUBLIC_PORTAL_NAME
ENV NEXT_PUBLIC_PORTAL_ACCOUNT_NAME=$NEXT_PUBLIC_PORTAL_ACCOUNT_NAME

RUN NEXT_TELEMETRY_DISABLED=1 npm run build -- --no-lint

FROM node:18-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]