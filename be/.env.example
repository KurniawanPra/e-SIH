NODE_ENV=development
HOST=0.0.0.0
PORT=3015

# Database Configuration (Prisma)
# Gunakan format DATABASE_URL langsung atau variabel DB_* terpisah
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/esih_db?schema=public"

# Alternatif style konfigurasi DB terpisah:
DB_CLIENT=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=esih_db
DB_SCHEMA=public

# SSO & Portal INL Integration
PORTAL_API_URL=http://localhost:3001
TARGET_APP_ID=924b0197-31b4-4620-b15e-c037989b49a3
SSO_INTERNAL_TOKEN=4fc937e29cf4bf2ca3c0e1813cd7685e
TARGET_FRONTEND_ORIGIN=http://localhost:8098
ALLOWED_ORIGINS=http://localhost:8098,http://localhost:3000

# Session & Security
# Generate dengan: openssl rand -hex 32 (Wajib diganti untuk production)
SESSION_SECRET_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_NAME=target_session
COOKIE_MAX_AGE_SECONDS=1800

# Set ke true jika di production/docker namun belum memakai HTTPS / domain SSL
ALLOW_INSECURE_HTTP=false
# COOKIE_SECURE=false
