{
  "name": "esih-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend e-SIH dengan Fastify dan Portal SSO",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "node dist/prisma/seed.js",
    "migrate:fresh": "prisma db push --force-reset",
    "migrate": "node scripts/prisma.cjs migrate deploy",
    "migrate:status": "node scripts/prisma.cjs migrate status",
    "migrate:dev": "node scripts/prisma.cjs migrate dev",
    "generate": "node scripts/prisma.cjs generate",
    "studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/secure-session": "8.3.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "5.12.1",
    "fastify-plugin": "5.1.0",
    "prisma": "^5.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^20.19.43",
    "tsx": "^4.20.3",
    "typescript": "5.8.3"
  }
}
